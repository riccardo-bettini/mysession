{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mysession-study-plan-v3",
  "title": "MySession Study Plan v3",
  "type": "object",
  "required": ["schemaVersion", "planId", "revision", "generatedAt", "session", "constraints", "courses", "exams", "units", "days"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 3 },
    "planId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "revision": { "type": "integer", "minimum": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "session": {
      "type": "object",
      "required": ["name", "sessionType", "academicYear", "startDate", "endDate"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "sessionType": { "enum": ["invernale", "estiva", "autunnale", "custom"] },
        "academicYear": { "type": "string" },
        "startDate": { "$ref": "#/$defs/date" },
        "endDate": { "$ref": "#/$defs/date" },
        "notes": { "type": "string" }
      }
    },
    "constraints": {
      "type": "object",
      "required": ["maxHoursPerDay", "studyWeekdays", "reviewDaysBeforeExam", "timezone"],
      "additionalProperties": false,
      "properties": {
        "maxHoursPerDay": { "type": "number", "exclusiveMinimum": 0, "maximum": 16 },
        "studyWeekdays": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 7 }
        },
        "offDates": { "type": "array", "items": { "$ref": "#/$defs/date" } },
        "reviewDaysBeforeExam": { "type": "integer", "minimum": 0 },
        "timezone": { "type": "string" }
      }
    },
    "courses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sigla", "name", "cfu", "colorHex", "active"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "sigla": { "type": "string" },
          "name": { "type": "string" },
          "code": { "type": "string" },
          "cfu": { "type": "number", "minimum": 0 },
          "professor": { "type": "string" },
          "colorHex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "difficultyWeight": { "type": "number", "minimum": 0 },
          "targetHours": { "type": "number", "minimum": 0 },
          "active": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    },
    "exams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "courseId", "date", "round", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "courseId": { "type": "string" },
          "date": { "$ref": "#/$defs/date" },
          "timeSlot": { "type": "string" },
          "durationMinutes": { "type": "integer", "minimum": 0 },
          "round": { "type": "string" },
          "examType": { "type": "string" },
          "classroom": { "type": "string" },
          "title": { "type": "string" },
          "status": { "enum": ["planned", "withdrawn"] }
        }
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "courseId", "unitNumber", "title", "estimatedHours"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "courseId": { "type": "string" },
          "unitNumber": { "type": "integer", "minimum": 1 },
          "chapter": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "estimatedHours": { "type": "number", "minimum": 0 },
          "priority": { "type": "integer", "minimum": 1, "maximum": 3 },
          "source": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "operationalPlan", "tasks", "quizzes"],
        "additionalProperties": false,
        "properties": {
          "date": { "$ref": "#/$defs/date" },
          "operationalPlan": {
            "type": "object",
            "required": ["dailyGoal", "blocks"],
            "additionalProperties": false,
            "properties": {
              "dailyGoal": { "type": "string", "minLength": 1 },
              "strategyNote": { "type": "string" },
              "blocks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "order", "courseId", "category", "title", "durationHours"],
                  "additionalProperties": false,
                  "properties": {
                    "id": { "type": "string" },
                    "order": { "type": "integer", "minimum": 1 },
                    "courseId": { "type": "string" },
                    "category": { "$ref": "#/$defs/taskCategory" },
                    "title": { "type": "string", "minLength": 1 },
                    "chapter": { "type": "string" },
                    "topic": { "type": "string" },
                    "pages": { "type": "string" },
                    "source": { "type": "string" },
                    "durationHours": { "type": "number", "exclusiveMinimum": 0 },
                    "instructions": { "type": "string" }
                  }
                }
              }
            }
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "courseId", "category", "title", "plannedHours"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "courseId": { "type": "string" },
                "unitId": { "type": "string" },
                "category": { "$ref": "#/$defs/taskCategory" },
                "title": { "type": "string", "minLength": 1 },
                "chapter": { "type": "string" },
                "topic": { "type": "string" },
                "pages": { "type": "string" },
                "source": { "type": "string" },
                "plannedHours": { "type": "number", "exclusiveMinimum": 0 },
                "priority": { "type": "integer", "minimum": 1, "maximum": 3 },
                "aliases": { "type": "array", "items": { "type": "string" } },
                "subtasks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "text"],
                    "additionalProperties": false,
                    "properties": {
                      "id": { "type": "string" },
                      "text": { "type": "string", "minLength": 1 },
                      "category": { "$ref": "#/$defs/taskCategory" },
                      "pages": { "type": "string" },
                      "aliases": { "type": "array", "items": { "type": "string" } }
                    }
                  }
                }
              }
            }
          },
          "quizzes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "courseId", "title", "questions"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "courseId": { "type": "string" },
                "title": { "type": "string", "minLength": 1 },
                "topicSummary": { "type": "string" },
                "aliases": { "type": "array", "items": { "type": "string" } },
                "questions": {
                  "type": "array",
                  "minItems": 5,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "required": ["id", "type", "category", "prompt", "explanation"],
                    "additionalProperties": false,
                    "properties": {
                      "id": { "type": "string" },
                      "type": { "enum": ["multiple_choice", "open_flashcard"] },
                      "category": { "$ref": "#/$defs/quizCategory" },
                      "chapter": { "type": "string" },
                      "topic": { "type": "string" },
                      "prompt": { "type": "string", "minLength": 1 },
                      "options": {
                        "type": "array",
                        "minItems": 4,
                        "maxItems": 4,
                        "items": { "type": "string", "minLength": 1 }
                      },
                      "correctIndex": { "type": "integer", "minimum": 0, "maximum": 3 },
                      "explanation": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "taskCategory": { "enum": ["teoria", "esercizi", "temi_esame", "dimostrazioni", "domande_orale", "ripasso"] },
    "quizCategory": { "enum": ["teoria", "esercizi", "temi_esame", "dimostrazioni", "domande_orale"] }
  }
}
